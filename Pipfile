# Dependencies are defined in pyproject.toml:
# this installs the package (with the dependencies needed to run the notebooks)
# so that the two stay in sync.
# uv users can instead use the uv.lock file: uv sync --extra notebooks

[dev-packages]
pytest = ">=9.0.0"
pytest-cov = ">=6.0.0"

[packages]
deepmreye = { path = ".", editable = true, extras = ["notebooks"] }
jupyterlab = ">=4.0.0"

[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

# install with: pipenv install --categories streamlit
[streamlit]
deepmreye = { path = ".", editable = true, extras = ["streamlit"] }
